# ===========================================================================
# StyleSphere backend - environment template
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. NEVER commit `.env`.
# ===========================================================================

# --- Neon PostgreSQL (ONLY database) ---------------------------------------
# Required format (the psycopg 3 driver prefix is mandatory):
#   DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# Get it from: Neon Console -> Project -> Connection Details
DATABASE_URL=

# --- JWT authentication ----------------------------------------------------
# Use a long random secret in development; rotate to invalidate all tokens.
JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ------------------------------------------------------------------
# Exact frontend origin. Wildcards ("*") are intentionally rejected.
FRONTEND_URL=http://localhost:5173

# --- Application -----------------------------------------------------------
APP_ENV=development

# --- Upstash / Redis (caching, rate limiting, background jobs) -------------
# Keep REDIS_ENABLED=false for tests/offline development where Redis is absent.
# Set REDIS_ENABLED=true and paste your provider-issued TCP URL to enable.
# Production Upstash must use the rediss:// (TLS) scheme.
REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT=5.0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=20

# --- Optional: real weather provider ---------------------------------------
# Leave unset to use the built-in development fallback (never exposed to clients).
# WEATHER_API_KEY=
# WEATHER_API_BASE_URL=https://api.openweathermap.org

# --- AI --------------------------------------------------------------------
AI_MODEL_PATH=./ai_models
AI_ENABLE_ML=true
AI_ENABLE_IMAGE_ANALYSIS=true

