# ===========================================================================
# StyleSphere - repository root .gitignore
# ===========================================================================

# --- Secrets (never commit environment files) ------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Node / React frontend -------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / FastAPI backend ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.python-version

# --- Testing / tooling caches ---------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- AI model artifacts ---------------------------------------------------
ai_models/
*.pkl
*.joblib
*.pt
*.pth

# --- Uploaded static assets ---
backend/static/uploads/*.webp
backend/static/uploads/*.jpg
backend/static/uploads/*.jpeg
backend/static/uploads/*.png
